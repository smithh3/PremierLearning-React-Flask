@echo off
rem 2026-11-09, Hal asked to pause the manager run while the points model is
rem checked on the synthetic seasons. Stops v3_lgbm_v6 just after its next
rem save. Continue it with resume_lgbm_v6.cmd.
rem Output is appended to fpl_manager_runs\pause_lgbm_v6.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=fpl_manager_runs\pause_lgbm_v6.log
echo. >> "%LOG%"
echo Started %DATE% %TIME% >> "%LOG%"
powershell -NoProfile -ExecutionPolicy Bypass -File fpl_manager\stop_after_save.ps1 -Names v3_lgbm_v6 >> "%LOG%" 2>&1
echo Paused %DATE% %TIME% (see stop_after_save.log) >> "%LOG%"
