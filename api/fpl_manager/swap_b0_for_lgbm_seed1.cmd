@echo off
rem 2026-11-09, Hal asked: cancel the B0 net manager run and use its processes for
rem more lightgbm v6 runs. Stops v3_v2_b0_noids just after its next save, then
rem starts a second never-ending lgbm_v6 run (set 97, its own policy, seed 1) in
rem fpl_manager_runs\v3_lgbm_v6_seed1. The first lgbm_v6 run is left alone.
rem Output is appended to fpl_manager_runs\swap_b0_for_lgbm_seed1.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=fpl_manager_runs\swap_b0_for_lgbm_seed1.log
echo. >> "%LOG%"
echo Started %DATE% %TIME% >> "%LOG%"
powershell -NoProfile -ExecutionPolicy Bypass -File fpl_manager\stop_after_save.ps1 -Names v3_v2_b0_noids >> "%LOG%" 2>&1
echo B0 run stopped %DATE% %TIME% (see stop_after_save.log), starting lgbm_v6 seed 1 >> "%LOG%"
call fpl_manager\run_manager_v3.cmd 97 fpl_manager_runs\v3_lgbm_v6_seed1 "--seed 1"
echo Finished %DATE% %TIME% >> "%LOG%"
