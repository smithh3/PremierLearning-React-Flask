@echo off
rem 2026-11-09, Hal asked: keep only the first lgbm_v6 manager run and give it
rem more processes. Stops v3_lgbm_v6_seed1 just after its next save (its
rem checkpoint is kept, so it could be resumed later), then stops v3_lgbm_v6 just
rem after its next save, then continues v3_lgbm_v6 from its checkpoint with 4
rem worker processes instead of 2. Runs per update stay at 8 (2 per process), so
rem updates come about twice as often.
rem Output is appended to fpl_manager_runs\switch_lgbm_v6_to_4_workers.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=fpl_manager_runs\switch_lgbm_v6_to_4_workers.log
echo. >> "%LOG%"
echo Started %DATE% %TIME% >> "%LOG%"
powershell -NoProfile -ExecutionPolicy Bypass -File fpl_manager\stop_after_save.ps1 -Names v3_lgbm_v6_seed1 >> "%LOG%" 2>&1
echo Seed 1 run stopped %DATE% %TIME% (see stop_after_save.log) >> "%LOG%"
powershell -NoProfile -ExecutionPolicy Bypass -File fpl_manager\stop_after_save.ps1 -Names v3_lgbm_v6 >> "%LOG%" 2>&1
echo Run 1 stopped %DATE% %TIME%, continuing it with 4 workers >> "%LOG%"
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set CHECKPOINT=fpl_manager_runs\v3_lgbm_v6
echo. >> "%CHECKPOINT%\console.log"
echo ===== Started %DATE% %TIME% set 97 v3, 4 workers ===== >> "%CHECKPOINT%\console.log"
"..\venv\Scripts\python.exe" -m fpl_manager --seasons 23,24,25 --prediction-set-id 97 --checkpoint "%CHECKPOINT%" --workers 4 --observation v3 >> "%CHECKPOINT%\console.log" 2>&1
echo Exit %ERRORLEVEL% >> "%CHECKPOINT%\console.log"
echo Finished %DATE% %TIME% >> "%LOG%"
