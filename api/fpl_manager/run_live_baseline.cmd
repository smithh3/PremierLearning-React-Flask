@echo off
rem 2026-11-13, Hal asked: what the live Fargate manager (plan_live settings,
rem sweep trial 39_stuck_rot) scores on the real 23/24, 24/25, 25/26 with the
rem set 105 forecasts, scored like the policy's eval runs. One process per
rem season; ~8 min a gameweek (about 6,000 squad solves each), ~4-5 h.
rem Output: fpl_manager_runs\live_baseline_set105\ (summary.csv, weeks_<season>.csv)
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set OUT=fpl_manager_runs\live_baseline_set105
if not exist "%OUT%" mkdir "%OUT%"
echo ===== live manager replay started %DATE% %TIME% ===== >> "%OUT%\console.log"
"..\venv\Scripts\python.exe" -m fpl_manager.live_baseline --prediction-set-id 105 --seasons 23,24,25 --workers 3 --out "%OUT%" >> "%OUT%\console.log" 2>&1
echo ===== live manager replay exit %ERRORLEVEL% %DATE% %TIME% ===== >> "%OUT%\console.log"
