@echo off
rem Continues v3_lgbm_v6 (set 97, 4 workers, known fixture calendar) from its
rem last checkpoint, as restart_lgbm_v6_known_calendar.cmd did after its stop.
rem Output goes to fpl_manager_runs\v3_lgbm_v6\console.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set CHECKPOINT=fpl_manager_runs\v3_lgbm_v6
echo. >> "%CHECKPOINT%\console.log"
echo ===== Resumed %DATE% %TIME% set 97 v3, 4 workers, known fixture calendar ===== >> "%CHECKPOINT%\console.log"
"..\venv\Scripts\python.exe" -m fpl_manager --seasons 23,24,25 --prediction-set-id 97 --checkpoint "%CHECKPOINT%" --workers 4 --observation v3 --calendar known >> "%CHECKPOINT%\console.log" 2>&1
echo Exit %ERRORLEVEL% >> "%CHECKPOINT%\console.log"
