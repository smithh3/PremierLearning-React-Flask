@echo off
rem One v3 fantasy manager run on a saved prediction set, with no terminal attached.
rem Usage: run_manager_v3.cmd <set id> <checkpoint folder> [--allow-oracle]
rem Plays 2023/24-2025/26 with 2 worker processes and the v3 observation until stopped.
rem v3 defaults: HiGHS first, range cache, autosubs, a quarter of each week's points
rem paid weekly, gamma 0.995, GAE 0.98, 8 runs per update, a top-choice run to
rem eval.csv every 5 updates.
rem Output is appended to <checkpoint folder>\console.log
rem Do not edit this file while a run is using it: cmd reads it as it goes.
cd /d "%~dp0.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set SET_ID=%~1
set CHECKPOINT=%~2
set EXTRA=%~3
if not exist "%CHECKPOINT%" mkdir "%CHECKPOINT%"
set LOG=%CHECKPOINT%\console.log
echo. >> "%LOG%"
echo ===== Started %DATE% %TIME% set %SET_ID% v3 %EXTRA% ===== >> "%LOG%"
rem fpl_manager continues a checkpoint by itself when its manifest exists.
"%PYTHON%" -m fpl_manager --seasons 23,24,25 --prediction-set-id %SET_ID% %EXTRA% --checkpoint "%CHECKPOINT%" --workers 2 --observation v3 >> "%LOG%" 2>&1
echo Exit %ERRORLEVEL% >> "%LOG%"
echo Finished %DATE% %TIME% >> "%LOG%"
