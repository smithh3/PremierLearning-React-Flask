@echo off
rem 2026-11-09, Hal asked for the manager to see only the fixture calendar a real
rem manager had at each deadline (blanks and doubles only once FPL showed them;
rem see simulation\fixture_calendar.py). Stops v3_lgbm_v6 just after its next
rem save, then continues it from that checkpoint with 4 workers and
rem --calendar known. Runs before this point used the final calendar.
rem Output is appended to fpl_manager_runs\restart_lgbm_v6_known_calendar.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=fpl_manager_runs\restart_lgbm_v6_known_calendar.log
echo. >> "%LOG%"
echo Started %DATE% %TIME% >> "%LOG%"
powershell -NoProfile -ExecutionPolicy Bypass -File fpl_manager\stop_after_save.ps1 -Names v3_lgbm_v6 >> "%LOG%" 2>&1
echo Run 1 stopped %DATE% %TIME% (see stop_after_save.log), continuing it on the known calendar >> "%LOG%"
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set CHECKPOINT=fpl_manager_runs\v3_lgbm_v6
echo. >> "%CHECKPOINT%\console.log"
echo ===== Started %DATE% %TIME% set 97 v3, 4 workers, known fixture calendar ===== >> "%CHECKPOINT%\console.log"
"..\venv\Scripts\python.exe" -m fpl_manager --seasons 23,24,25 --prediction-set-id 97 --checkpoint "%CHECKPOINT%" --workers 4 --observation v3 --calendar known >> "%CHECKPOINT%\console.log" 2>&1
echo Exit %ERRORLEVEL% >> "%CHECKPOINT%\console.log"
echo Finished %DATE% %TIME% >> "%LOG%"
