@echo off
rem Starts the three v3 manager runs side by side, 2 worker processes each, with no terminal attached.
rem Same three prediction sets as the v2 runs: minbands blend (35), ORACLE (34), v1_h5 (29).
rem Starts are 2 minutes apart so the season loading does not peak at the same time.
rem Each run logs to its checkpoint's console.log. They run until stopped.
rem The oracle is fed the real minutes players went on to play, so it cheats: compare it as a ceiling only.
rem Do not edit this file while it is running: cmd reads it as it goes.
cd /d "%~dp0"
start "" /b cmd /c run_manager_v3.cmd 35 fpl_manager_runs/v3_v2_log_minbands_blend25
rem ping waits about 2 minutes; timeout refuses to run without a console.
ping -n 121 127.0.0.1 > nul
start "" /b cmd /c run_manager_v3.cmd 34 fpl_manager_runs/v3_ORACLE_v2_log_real_minutes --allow-oracle
ping -n 121 127.0.0.1 > nul
start "" /b cmd /c run_manager_v3.cmd 29 fpl_manager_runs/v3_v1_h5
