@echo off
rem 2026-11-13, Hal asked: after the live-manager replay, play the current
rem run's policy on 2026/27 so far, then resume the paused training run.
rem 1. wait for the live-manager replay (run_live_baseline.cmd, PID passed as %1)
rem 2. lgbm_v6 forecasts for 2026/27 GW1-10, made at each deadline from what was
rem    known then (simulation.replay_live_season build), set eval-lgbm_v6-2627-replay
rem 3. policy (top choice) and rules manager over GW1-10 (fpl_manager.play_live_season)
rem 4. resume v3_lgbm_v6_copies_fixed (synthetic_seasons\resume_selectfix_manager.cmd),
rem    whether or not 2-3 worked
rem Log: fpl_manager_runs\season_2627_replay\console.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set OUT=fpl_manager_runs\season_2627_replay
if not exist "%OUT%" mkdir "%OUT%"
set LOG=%OUT%\console.log
echo ===== chain started %DATE% %TIME%, waiting for PID %1 ===== >> "%LOG%"
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if not errorlevel 1 (
    ping -n 61 127.0.0.1 >nul
    goto wait
)
echo ===== live replay finished, forecast build %DATE% %TIME% ===== >> "%LOG%"
"..\venv\Scripts\python.exe" -m simulation.replay_live_season build -- --lightgbm --train-once-per-season --lgbm-plan simple_h1_b1 --lgbm-features 4 --lgbm-no-ids --lgbm-seeds 3 --seasons 26 --to-gw 10 --name eval-lgbm_v6-2627-replay >> "%LOG%" 2>&1
if errorlevel 1 goto resume
echo ===== forecasts built, playing %DATE% %TIME% ===== >> "%LOG%"
"..\venv\Scripts\python.exe" -m fpl_manager.play_live_season --set-name eval-lgbm_v6-2627-replay --last 10 --checkpoint fpl_manager_runs\v3_lgbm_v6_copies_fixed --out "%OUT%" >> "%LOG%" 2>&1
:resume
echo ===== resuming the training run %DATE% %TIME% ===== >> "%LOG%"
call synthetic_seasons\resume_selectfix_manager.cmd
