@echo off
rem 2026-11-11: Hal asked for the can_select fix and a fresh copies manager run.
rem 1. re-flag selectable in the copies' forecasts (copy 24/1 done by hand) and
rem    copy set 97 into set 105 with the corrected flag (fix_selectable.py);
rem    each step stops if the stored flags don't match the old rule
rem 2. tests (historical data + synthetic seasons + fpl_manager)
rem 3. pool files for copies 1-10 (new ids, COPY_GENERATION 2)
rem 4. a NEW v3 manager run, fpl_manager_runs\v3_lgbm_v6_copies_fixed, from
rem    scratch: set 105 for the real seasons, real + copies 1-5 in training,
rem    held-out 6-10, 4 workers, known calendar. Runs until stopped.
rem The stopped v3_lgbm_v6_copies run (1,148 runs, broken pool) is kept as is.
rem Output: data\synthetic\selectfix_manager.log, then the run's console.log.
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=data\synthetic\selectfix_manager.log
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set CHECKPOINT=fpl_manager_runs\v3_lgbm_v6_copies_fixed
echo. >> "%LOG%"
echo ===== can_select fix + copies manager chain, started %DATE% %TIME% ===== >> "%LOG%"
"..\venv\Scripts\python.exe" -m synthetic_seasons.fix_selectable copies --seasons 23,24,25 --copies 1-10 >> "%LOG%" 2>&1
if errorlevel 1 goto failed
"..\venv\Scripts\python.exe" -m synthetic_seasons.fix_selectable set --from-set 97 >> "%LOG%" 2>&1
if errorlevel 1 goto failed
"..\venv\Scripts\python.exe" -m unittest tests.test_historical_data tests.test_synthetic_seasons tests.test_fpl_manager >> "%LOG%" 2>&1
if errorlevel 1 goto failed
"..\venv\Scripts\python.exe" -m synthetic_seasons prepare-pools --seasons 23,24,25 --copies 1-10 >> "%LOG%" 2>&1
if errorlevel 1 goto failed
if not exist "%CHECKPOINT%" mkdir "%CHECKPOINT%"
echo Manager run starting %DATE% %TIME%, console in %CHECKPOINT%\console.log >> "%LOG%"
echo ===== Started %DATE% %TIME% set 105 v3 + copies 1-5, held out 6-10, 4 workers, known calendar ===== >> "%CHECKPOINT%\console.log"
"..\venv\Scripts\python.exe" -m fpl_manager --seasons 23,24,25 --prediction-set-id 105 --checkpoint "%CHECKPOINT%" --workers 4 --observation v3 --calendar known --copies 1-5 --heldout-copies 6-10 --evaluate-every 4 >> "%CHECKPOINT%\console.log" 2>&1
echo Manager run exit %ERRORLEVEL% %DATE% %TIME% >> "%LOG%"
exit /b 0
:failed
echo FAILED with exit %ERRORLEVEL% %DATE% %TIME% >> "%LOG%"
exit /b 1
