@echo off
rem 2026-11-09, Hal asked to compare the v6 points model's error on the
rem synthetic copies with real seasons (manager run paused for it). For each
rem season: one v6 fit, then the real season and copies 1 and 2 at GW 2, 6, ..., 34.
rem Table: data\synthetic\POINTS_MODEL_CHECK.md
rem Output is appended to data\synthetic\points_check.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=data\synthetic\points_check.log
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
echo. >> "%LOG%"
echo ===== Started %DATE% %TIME% ===== >> "%LOG%"
"..\venv\Scripts\python.exe" -m synthetic_seasons check --seasons 25,23,22,21 --copies 1,2 >> "%LOG%" 2>&1
echo Exit %ERRORLEVEL% %DATE% %TIME% >> "%LOG%"
