@echo off
rem 2026-11-09, Hal asked for 100 synthetic seasons with 2024/25 added as a
rem source: 20 copies each of 21/22, 22/23, 23/24, 24/25, 25/26. Copies 1-5 of
rem 21,22,23,25 already exist (same seeds, so they are not rebuilt).
rem Output is appended to data\synthetic\generate.log, report to REALISM_REPORT.md
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=data\synthetic\generate.log
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
echo. >> "%LOG%"
echo ===== 100 copies, started %DATE% %TIME% ===== >> "%LOG%"
"..\venv\Scripts\python.exe" -m synthetic_seasons generate --seasons 24 --copies 20 --start 1 >> "%LOG%" 2>&1
"..\venv\Scripts\python.exe" -m synthetic_seasons generate --seasons 21,22,23,25 --copies 15 --start 6 >> "%LOG%" 2>&1
"..\venv\Scripts\python.exe" -m synthetic_seasons report --seasons 21,22,23,24,25 >> "%LOG%" 2>&1
echo Exit %ERRORLEVEL% %DATE% %TIME% >> "%LOG%"
