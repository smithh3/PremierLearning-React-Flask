@echo off
rem 2026-11-10, Hal asked to play the trained v3_lgbm_v6 manager (paused) on
rem synthetic copies of the seasons it trained on, against the rule-based
rem manager, to see whether it overfitted the real 23/24-25/26.
rem Waits for the points-model check (run_points_check.cmd) to finish first.
rem Steps (24/25 copies 1-2 were made first): v6 forecasts for copy 1 of 23, 24, 25; manager
rem check on the real seasons and copy 1; then the same for copy 2.
rem Results: data\synthetic\manager_check.csv. Log: data\synthetic\manager_check.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=data\synthetic\manager_check.log
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set DATABASE_PATH=/data/model_eval.db
echo. >> "%LOG%"
echo ===== Queued %DATE% %TIME%, waiting for the points check ===== >> "%LOG%"
powershell -NoProfile -Command "Wait-Process -Id 2924 -ErrorAction SilentlyContinue" >> "%LOG%" 2>&1
echo Points check done %DATE% %TIME% >> "%LOG%"
"..\venv\Scripts\python.exe" -m synthetic_seasons forecast --seasons 23,24,25 --copies 1 >> "%LOG%" 2>&1
"..\venv\Scripts\python.exe" -m synthetic_seasons.manager_check --copies 1 >> "%LOG%" 2>&1
"..\venv\Scripts\python.exe" -m synthetic_seasons forecast --seasons 23,24,25 --copies 2 >> "%LOG%" 2>&1
"..\venv\Scripts\python.exe" -m synthetic_seasons.manager_check --copies 2 --skip-real >> "%LOG%" 2>&1
echo Exit %ERRORLEVEL% %DATE% %TIME% >> "%LOG%"
