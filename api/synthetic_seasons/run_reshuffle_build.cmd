@echo off
rem 2026-11-10: Hal approved the fixture reshuffle (schedule.py) and the forecast
rem build for copies 1-10 of 2023/24, 2024/25 and 2025/26 (5 to train the
rem manager on, 5 held out).
rem 1. regenerate the 30 copies with the fixed generator (about 2 min, light);
rem    Hal keeps only these 30 (the other 70 were deleted 2026-11-10)
rem 2. realism report and rule checks (REALISM_REPORT.md)
rem Run 1 stopped at step 3 (copy path differed: duplicate player folders gave
rem the copies extra rows; fixed in source._player_files); this is run 2.
rem 3. pipeline check: copy path with the past-season cache == the real path;
rem    the job stops here if it fails (about 12 min, heavy)
rem 4. v6 forecasts for the 30 copies (about 9 h, heavy, about 4 GB)
rem Output is appended to data\synthetic\reshuffle_build.log.
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=data\synthetic\reshuffle_build.log
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
echo. >> "%LOG%"
echo ===== reshuffle build, started %DATE% %TIME% ===== >> "%LOG%"
"..\venv\Scripts\python.exe" -m synthetic_seasons generate --seasons 23,24,25 --copies 10 --start 1 >> "%LOG%" 2>&1
if errorlevel 1 goto failed
"..\venv\Scripts\python.exe" -m synthetic_seasons report --seasons 23,24,25 >> "%LOG%" 2>&1
if errorlevel 1 goto failed
"..\venv\Scripts\python.exe" -m synthetic_seasons pipeline-check --seasons 25 >> "%LOG%" 2>&1
if errorlevel 1 goto failed
"..\venv\Scripts\python.exe" -m synthetic_seasons forecast --seasons 23,24,25 --copies 1-10 >> "%LOG%" 2>&1
if errorlevel 1 goto failed
echo Exit 0 %DATE% %TIME% >> "%LOG%"
exit /b 0
:failed
echo FAILED with exit %ERRORLEVEL% %DATE% %TIME% >> "%LOG%"
exit /b 1
