@echo off
rem 2026-11-10: Hal asked for manager training on the synthetic copies to start
rem as soon as their forecasts are built (real seasons kept in the mix).
rem 1. waits for the forecast build (run_reshuffle_build.cmd, PID 14888) to end
rem    and stops unless its log ends "Exit 0"
rem 2. tests (synthetic seasons + fpl_manager); stops if any fail
rem 3. pool files for copies 1-10 of 23/24, 24/25, 25/26 (one per copy week,
rem    so the workers never hold the forecast rows); about 30-60 min
rem 4. a NEW v3 manager run, fpl_manager_runs\v3_lgbm_v6_copies, from scratch:
rem    set 97 for the real seasons, 4 workers, known calendar; each season of a
rem    run is the real one or copy 1-5 at random; evaluation runs (every 4
rem    updates) cycle real, held-out copy 6, 7, 8, 9, 10. Runs until stopped.
rem v3_lgbm_v6 stays paused and is not touched.
rem Output: data\synthetic\copies_manager.log, then the run's console.log.
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0.."
set LOG=data\synthetic\copies_manager.log
set BUILD_LOG=data\synthetic\reshuffle_build.log
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set CHECKPOINT=fpl_manager_runs\v3_lgbm_v6_copies
echo. >> "%LOG%"
echo ===== copies manager chain, started %DATE% %TIME% ===== >> "%LOG%"
:wait
tasklist /FI "PID eq 14888" 2>nul | find "14888" >nul
if errorlevel 1 goto built
ping -n 61 127.0.0.1 >nul
goto wait
:built
echo Forecast build ended %DATE% %TIME% >> "%LOG%"
powershell -NoProfile -Command "if ((Get-Content '%BUILD_LOG%' -Tail 1) -like 'Exit 0*') { exit 0 } else { exit 1 }"
if errorlevel 1 (
  echo The forecast build did not end with Exit 0; nothing started. >> "%LOG%"
  goto failed
)
"..\venv\Scripts\python.exe" -m unittest tests.test_synthetic_seasons tests.test_fpl_manager >> "%LOG%" 2>&1
if errorlevel 1 goto failed
"..\venv\Scripts\python.exe" -m synthetic_seasons prepare-pools --seasons 23,24,25 --copies 1-10 >> "%LOG%" 2>&1
if errorlevel 1 goto failed
if not exist "%CHECKPOINT%" mkdir "%CHECKPOINT%"
echo Manager run starting %DATE% %TIME%, console in %CHECKPOINT%\console.log >> "%LOG%"
echo ===== Started %DATE% %TIME% set 97 v3 + copies 1-5, held out 6-10, 4 workers, known calendar ===== >> "%CHECKPOINT%\console.log"
"..\venv\Scripts\python.exe" -m fpl_manager --seasons 23,24,25 --prediction-set-id 97 --checkpoint "%CHECKPOINT%" --workers 4 --observation v3 --calendar known --copies 1-5 --heldout-copies 6-10 --evaluate-every 4 >> "%CHECKPOINT%\console.log" 2>&1
echo Manager run exit %ERRORLEVEL% %DATE% %TIME% >> "%LOG%"
exit /b 0
:failed
echo FAILED with exit %ERRORLEVEL% %DATE% %TIME% >> "%LOG%"
exit /b 1
