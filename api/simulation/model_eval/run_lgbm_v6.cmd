@echo off
rem LightGBM v6 (2026-11-07, Hal asked): FPL's own player news beyond the flat
rem chance (premierlearning/lgbm/news.py, feature set 4). Queued behind the
rem LightGBM v4 job (process id given as the first argument). Then:
rem   1. runs the unit tests (stops if any fail)
rem   2. tops up the saved FPL news (skips deadlines already on disk)
rem   3. builds lgbm_v6 (v4 + news) and lgbm_v6_staged (v5 + news), ~1-1.5 h each
rem   4. 50/50 mixes of both with the no-id B0 net
rem   5. scores v1, the net, lgbm v3-v6 and the mixes (run-id lgbm_v6)
rem Output is appended to api\run_metrics\model_eval\run_lgbm_v6.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_lgbm_v6.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_lgbm_news tests.test_lgbm tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
"%PYTHON%" -m premierlearning.lgbm.news >> "%LOG%" 2>&1
echo === lgbm_v6 %DATE% %TIME% === >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only lgbm_v6 >> "%LOG%" 2>&1
echo === lgbm_v6_staged %DATE% %TIME% === >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only lgbm_v6_staged >> "%LOG%" 2>&1
echo Built %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v6 v2_b0_noids >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v6_staged v2_b0_noids >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v2_b0_noids lgbm_v3 lgbm_v4 lgbm_v5 lgbm_v6 lgbm_v6_staged --seasons 25 --no-panel --set lgbm_v4_mix50_v2_b0_noids=eval-lgbm_v4_mix50_v2_b0_noids --set lgbm_v5_mix50_v2_b0_noids=eval-lgbm_v5_mix50_v2_b0_noids --set lgbm_v6_mix50_v2_b0_noids=eval-lgbm_v6_mix50_v2_b0_noids --set lgbm_v6_staged_mix50_v2_b0_noids=eval-lgbm_v6_staged_mix50_v2_b0_noids --run-id lgbm_v6 >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
