@echo off
rem LightGBM v3 variants (2026-11-05). Optionally waits for the process id given
rem as the first argument to exit, then:
rem   1. runs the unit tests (stops if any fail)
rem   2. builds on 2025/26, all on the v3 inputs (feature set 2, 3 seeds):
rem      lgbm_v3_rank             ranking objective (lambdarank by gameweek)
rem      lgbm_v3_linear           linear leaves
rem      lgbm_v3_id_stage         team ids as a separate correction that must
rem                               earn its rounds on the held-out season
rem      lgbm_v3_recent           older seasons down-weighted (half-life 2)
rem      lgbm_v3_id_stage_recent  both
rem   3. 50/50 mixes: each with the B0 net, and lgbm_v3 with lgbm_v3_rank
rem   4. scores everything against v1 (run-id lgbm_v3_variants)
rem Output is appended to api\run_metrics\model_eval\run_lgbm_v3_variants.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_lgbm_v3_variants.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_lgbm tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only lgbm_v3_rank lgbm_v3_id_stage lgbm_v3_recent lgbm_v3_linear lgbm_v3_id_stage_recent >> "%LOG%" 2>&1
echo Built %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3_rank v2_b0_seed1 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3 lgbm_v3_rank >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3_linear v2_b0_seed1 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3_id_stage v2_b0_seed1 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3_recent v2_b0_seed1 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3_id_stage_recent v2_b0_seed1 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v2_b0_seed1 lgbm_v3 lgbm_v3_ids lgbm_v3_rank lgbm_v3_linear lgbm_v3_id_stage lgbm_v3_recent lgbm_v3_id_stage_recent --seasons 25 --no-panel --set lgbm_v3_mix50_v2_b0_seed1=eval-lgbm_v3_mix50_v2_b0_seed1 --set lgbm_v3_rank_mix50_v2_b0_seed1=eval-lgbm_v3_rank_mix50_v2_b0_seed1 --set lgbm_v3_mix50_lgbm_v3_rank=eval-lgbm_v3_mix50_lgbm_v3_rank --set lgbm_v3_linear_mix50_v2_b0_seed1=eval-lgbm_v3_linear_mix50_v2_b0_seed1 --set lgbm_v3_id_stage_mix50_v2_b0_seed1=eval-lgbm_v3_id_stage_mix50_v2_b0_seed1 --set lgbm_v3_recent_mix50_v2_b0_seed1=eval-lgbm_v3_recent_mix50_v2_b0_seed1 --set lgbm_v3_id_stage_recent_mix50_v2_b0_seed1=eval-lgbm_v3_id_stage_recent_mix50_v2_b0_seed1 --run-id lgbm_v3_variants >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
