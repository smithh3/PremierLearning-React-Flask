@echo off
rem LightGBM v1 and v2, queued behind the B1 staged v2 run. Waits for the
rem process id given as the first argument (run_b1_staged_v2_comparison) to exit,
rem then:
rem   1. runs the unit tests (stops if any fail)
rem   2. builds lgbm_v1 (plan simple_h1 inputs) and lgbm_v2 (plan simple_h1_b1
rem      inputs) on 2025/26, blends each 25% with v2_log_h5 like the nets, and
rem      scores them against v1, the minbands blend, B0 and B1 (run-id lgbm_1).
rem Output is appended to api\run_metrics\model_eval\run_lgbm_comparison.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_lgbm_comparison.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_lgbm tests.test_learning_v2 tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only lgbm_v1 lgbm_v2 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend lgbm_v1 --blend lgbm_v2 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v1_h5 v2_log_minbands v2_b0_seed1 v2_b0_seed2 v2_b1_context lgbm_v1 lgbm_v2 --seasons 25 --no-panel --set v2_log_minbands_blend25=eval-v2_log_minbands_blend25 --set v2_b0_seed1_blend25=eval-v2_b0_seed1_blend25 --set v2_b0_seed2_blend25=eval-v2_b0_seed2_blend25 --set v2_b1_context_blend25=eval-v2_b1_context_blend25 --set lgbm_v1_blend25=eval-lgbm_v1_blend25 --set lgbm_v2_blend25=eval-lgbm_v2_blend25 --run-id lgbm_1 >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
