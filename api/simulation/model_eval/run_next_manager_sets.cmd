@echo off
rem Build what the next two manager runs need, with no terminal attached: v2_log_minbands
rem and the cheating oracle for 2023/24 and 2024/25 (their 2025/26 rows already exist),
rem then the minbands 25% h5 blend. Everything lands in model_eval.db under eval-* names.
rem Output is appended to api\run_metrics\model_eval\run_next_manager_sets.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_next_manager_sets.log
echo. >> "%LOG%"
echo Started %DATE% %TIME% >> "%LOG%"

"%PYTHON%" -m simulation.model_eval build-all --seasons 23,24 --only v2_log_minbands v2_log_oracle_minutes >> "%LOG%" 2>&1

rem Fails if any season is missing, so a partial chain is never reported as ready.
"%PYTHON%" -m simulation.model_eval.manager_sets --next >> "%LOG%" 2>&1
echo Exit %ERRORLEVEL% >> "%LOG%"
echo Finished %DATE% %TIME% >> "%LOG%"
