@echo off
rem Recency pooling on 2025/26, queued behind the scoreline comparison: waits for
rem the process id given as the first argument (if any) to exit, then builds:
rem   1. v2_log_minbands_teams_recency_nodecay  recency attention pooling, no fading averages
rem   2. v2_log_minbands_teams_recency          the same with the fading averages kept
rem After each: blend 25% with v2_log_h5 and score against v1, the live blend and
rem v2_log_minbands_teams (blended and not).
rem Output is appended to api\run_metrics\model_eval\run_recency_comparison.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_recency_comparison.log
set SCORE=evaluate --seasons 25 --no-panel --set v2_log_minbands_blend25=eval-v2_log_minbands_blend25 --set v2_log_minbands_teams_blend25=eval-v2_log_minbands_teams_blend25
set KNOWN=v1 v1_h5 v2_log_minbands v2_log_minbands_teams
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_learning_v2 tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_log_minbands_teams_recency_nodecay >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_log_minbands_teams_recency_nodecay >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval %SCORE% --experiments %KNOWN% v2_log_minbands_teams_recency_nodecay --set v2_log_minbands_teams_recency_nodecay_blend25=eval-v2_log_minbands_teams_recency_nodecay_blend25 --run-id recency_1 >> "%LOG%" 2>&1
echo Done 1/2 v2_log_minbands_teams_recency_nodecay %DATE% %TIME% >> "%LOG%"

"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_log_minbands_teams_recency >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_log_minbands_teams_recency >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval %SCORE% --experiments %KNOWN% v2_log_minbands_teams_recency_nodecay v2_log_minbands_teams_recency --set v2_log_minbands_teams_recency_nodecay_blend25=eval-v2_log_minbands_teams_recency_nodecay_blend25 --set v2_log_minbands_teams_recency_blend25=eval-v2_log_minbands_teams_recency_blend25 --run-id recency_2 >> "%LOG%" 2>&1
echo Done 2/2 v2_log_minbands_teams_recency %DATE% %TIME% >> "%LOG%"
echo Finished %DATE% %TIME% >> "%LOG%"
