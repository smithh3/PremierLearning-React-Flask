@echo off
rem Wave B step 1 (context scalars), queued behind B0. Waits for the process id
rem given as the first argument (run_b0_comparison) to exit, then:
rem   1. derive_plan checks the external features cover 2018/19-2025/26 (the full
rem      overnight build, not the summer-2025 test window) and writes
rem      simple_h1_b1.json = B0's plan + schedule, gameweek and player_load
rem   2. runs the unit tests (stops if any fail)
rem   3. builds v2_b1_context (seed 42, as v2_b0_seed1), blends it 25% with
rem      v2_log_h5, and scores it against both B0 seeds (run-id b1)
rem Output is appended to api\run_metrics\model_eval\run_b1_comparison.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_b1_comparison.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Deriving the plan %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval.derive_plan --base simple_h1_b0 --out simple_h1_b1 --family context --require-seasons 2018-2025 >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Plan or features not ready, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_learning_v2 tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_b1_context >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_b1_context >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --seasons 25 --no-panel --experiments v1 v1_h5 v2_log_minbands v2_b0_seed1 v2_b0_seed2 v2_b1_context --set v2_log_minbands_blend25=eval-v2_log_minbands_blend25 --set v2_b0_seed1_blend25=eval-v2_b0_seed1_blend25 --set v2_b0_seed2_blend25=eval-v2_b0_seed2_blend25 --set v2_b1_context_blend25=eval-v2_b1_context_blend25 --run-id b1 >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
