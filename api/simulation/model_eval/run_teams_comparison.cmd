@echo off
rem Build the team-history models on 2025/26, one after another, with no terminal
rem attached, as the minutes heads were tested. After each build: blend it 25% with
rem v2_log_h5 (as the live blend, set 35, is) and score everything built so far
rem against v1, v2_log_minbands and the live blend, so stopping early still leaves results.
rem   1. v2_log_minbands_teams          transformers over 114 matches per side, team time blocks
rem   2. v2_log_minbands_teams_pblocks  plus player time blocks
rem   3. v2_log_minbands_teams_attn     the same histories through one attention pass
rem 2023/24 and 2024/25 can be added later for manager runs (build-all --seasons 23,24).
rem Everything lands in model_eval.db under eval-* names. Output is appended to
rem api\run_metrics\model_eval\run_teams_comparison.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_teams_comparison.log
set SCORE=evaluate --seasons 25 --no-panel --set v2_log_minbands_blend25=eval-v2_log_minbands_blend25
set KNOWN=v1 v1_h5 v2_log v2_log_h5 v2_log_minbands
echo. >> "%LOG%"
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"

"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_log_minbands_teams >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_log_minbands_teams >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval %SCORE% --experiments %KNOWN% v2_log_minbands_teams --set v2_log_minbands_teams_blend25=eval-v2_log_minbands_teams_blend25 --run-id teams_1 >> "%LOG%" 2>&1
echo Done 1/3 v2_log_minbands_teams %DATE% %TIME% >> "%LOG%"

"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_log_minbands_teams_pblocks >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_log_minbands_teams_pblocks >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval %SCORE% --experiments %KNOWN% v2_log_minbands_teams v2_log_minbands_teams_pblocks --set v2_log_minbands_teams_blend25=eval-v2_log_minbands_teams_blend25 --set v2_log_minbands_teams_pblocks_blend25=eval-v2_log_minbands_teams_pblocks_blend25 --run-id teams_2 >> "%LOG%" 2>&1
echo Done 2/3 v2_log_minbands_teams_pblocks %DATE% %TIME% >> "%LOG%"

"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_log_minbands_teams_attn >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_log_minbands_teams_attn >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval %SCORE% --experiments %KNOWN% v2_log_minbands_teams v2_log_minbands_teams_pblocks v2_log_minbands_teams_attn --set v2_log_minbands_teams_blend25=eval-v2_log_minbands_teams_blend25 --set v2_log_minbands_teams_pblocks_blend25=eval-v2_log_minbands_teams_pblocks_blend25 --set v2_log_minbands_teams_attn_blend25=eval-v2_log_minbands_teams_attn_blend25 --run-id teams_3 >> "%LOG%" 2>&1
echo Done 3/3 v2_log_minbands_teams_attn %DATE% %TIME% >> "%LOG%"
echo Finished %DATE% %TIME% >> "%LOG%"
