@echo off
rem Build the scoreline models on 2025/26, one after another, with no terminal
rem attached, as the team-history models were tested. After each build: blend it
rem 25% with v2_log_h5 (as the live blend, set 35, is) and score it against v1,
rem the live blend and v2_log_minbands_teams (blended and not).
rem   1. v2_log_minbands_teams_score      plus a training-only head on team goals for/against
rem   2. v2_log_minbands_teams_scoreline  points built from minutes bands and expected goals
rem Output is appended to api\run_metrics\model_eval\run_scoreline_comparison.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_scoreline_comparison.log
set SCORE=evaluate --seasons 25 --no-panel --set v2_log_minbands_blend25=eval-v2_log_minbands_blend25 --set v2_log_minbands_teams_blend25=eval-v2_log_minbands_teams_blend25
set KNOWN=v1 v1_h5 v2_log_minbands v2_log_minbands_teams
echo. >> "%LOG%"
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"

"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_log_minbands_teams_score >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_log_minbands_teams_score >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval %SCORE% --experiments %KNOWN% v2_log_minbands_teams_score --set v2_log_minbands_teams_score_blend25=eval-v2_log_minbands_teams_score_blend25 --run-id scoreline_1 >> "%LOG%" 2>&1
echo Done 1/2 v2_log_minbands_teams_score %DATE% %TIME% >> "%LOG%"

"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_log_minbands_teams_scoreline >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_log_minbands_teams_scoreline >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval %SCORE% --experiments %KNOWN% v2_log_minbands_teams_score v2_log_minbands_teams_scoreline --set v2_log_minbands_teams_score_blend25=eval-v2_log_minbands_teams_score_blend25 --set v2_log_minbands_teams_scoreline_blend25=eval-v2_log_minbands_teams_scoreline_blend25 --run-id scoreline_2 >> "%LOG%" 2>&1
echo Done 2/2 v2_log_minbands_teams_scoreline %DATE% %TIME% >> "%LOG%"
echo Finished %DATE% %TIME% >> "%LOG%"
