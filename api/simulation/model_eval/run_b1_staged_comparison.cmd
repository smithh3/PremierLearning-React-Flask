@echo off
rem Staged re-check on wave B's inputs, queued behind B1. The 11-03 staged run
rem (staged_1) used wave A's inputs, before the fixture and minutes context
rem (all-competition rest, doubles / blanks, minutes load) was in. Waits for
rem the process id given as the first argument (run_b1_comparison) to exit, then:
rem   1. stops unless B1 wrote its report (run_metrics\model_eval\b1)
rem   2. derive_plan writes simple_h1_b1_staged.json = B1's plan with
rem      points_structure staged and the score head at 0.1 (stops if B1 is
rem      already staged, i.e. staged won wave A)
rem   3. runs the unit tests (stops if any fail)
rem   4. builds v2_b1_staged (seed 42, as v2_b1_context), blends it 25% with
rem      v2_log_h5, and scores it against B1 and both B0 seeds (run-id b1_staged)
rem Output is appended to api\run_metrics\model_eval\run_b1_staged_comparison.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_b1_staged_comparison.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
if not exist run_metrics\model_eval\b1\comparison.txt (
    echo No B1 report, so B1 did not run: nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Deriving the plan %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval.derive_plan --base simple_h1_b1 --out simple_h1_b1_staged --family staged >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Plan not written, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_learning_v2 tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_b1_staged >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_b1_staged >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --seasons 25 --no-panel --experiments v1 v1_h5 v2_log_minbands v2_b0_seed1 v2_b0_seed2 v2_b1_context v2_b1_staged --set v2_log_minbands_blend25=eval-v2_log_minbands_blend25 --set v2_b0_seed1_blend25=eval-v2_b0_seed1_blend25 --set v2_b0_seed2_blend25=eval-v2_b0_seed2_blend25 --set v2_b1_context_blend25=eval-v2_b1_context_blend25 --set v2_b1_staged_blend25=eval-v2_b1_staged_blend25 --run-id b1_staged >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
