@echo off
rem Retraining every 5 gameweeks (2026-11-05). Waits for the process id given as
rem the first argument (the LightGBM v3 variants job) to exit, then:
rem   1. runs the unit tests (stops if any fail)
rem   2. picks the best single LightGBM scored so far (runs lgbm_v3 and
rem      lgbm_v3_variants; pick_lgbm.py) and builds its _every5 twin
rem   3. interim evaluation of that LightGBM pair (run-id retrain_every5_lgbm)
rem   4. builds v2_b1_every5: the B1 net refitted at GW1, 6, ..., 36 (~26 h)
rem   5. 50/50 mixes of LightGBM and the net, for both schedules
rem   6. scores everything against v1 (run-id retrain_every5)
rem Output is appended to api\run_metrics\model_eval\run_retrain_every5.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_retrain_every5.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_lgbm tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
"%PYTHON%" -m simulation.model_eval.pick_lgbm --runs lgbm_v3 lgbm_v3_variants --out retrain_every5 >> "%LOG%" 2>&1
if errorlevel 1 (
    echo No LightGBM pick, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
set /p BEST=<run_metrics\model_eval\retrain_every5\lgbm_choice.txt
set EXTRA=lgbm_v3
if "%BEST%"=="lgbm_v3" set EXTRA=
echo Picked %BEST%, started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only %BEST%_every5 >> "%LOG%" 2>&1
echo Built %BEST%_every5 %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v2_b0_seed1 v2_b1_context %EXTRA% %BEST% %BEST%_every5 --seasons 25 --no-panel --set lgbm_v3_mix50_v2_b0_seed1=eval-lgbm_v3_mix50_v2_b0_seed1 --run-id retrain_every5_lgbm >> "%LOG%" 2>&1
echo Interim evaluation done %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_b1_every5 >> "%LOG%" 2>&1
echo Built v2_b1_every5 %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix %BEST%_every5 v2_b1_every5 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix %BEST% v2_b1_context >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v2_b0_seed1 v2_b1_context v2_b1_every5 %EXTRA% %BEST% %BEST%_every5 --seasons 25 --no-panel --set lgbm_v3_mix50_v2_b0_seed1=eval-lgbm_v3_mix50_v2_b0_seed1 --set %BEST%_mix50_v2_b1_context=eval-%BEST%_mix50_v2_b1_context --set %BEST%_every5_mix50_v2_b1_every5=eval-%BEST%_every5_mix50_v2_b1_every5 --run-id retrain_every5 >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
