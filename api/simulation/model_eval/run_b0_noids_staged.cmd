@echo off
rem B0 without id embeddings, scoreline built into points (2026-11-06, Hal asked;
rem runs ahead of the every-5 retraining job). Waits for the process id given as
rem the first argument (if any) to exit, then:
rem   1. runs the unit tests (stops if any fail)
rem   2. builds v2_b0_noids_staged on 2025/26 (~3.5 h)
rem   3. 50/50 mixes of lgbm_v3 with v2_b0_noids and with v2_b0_noids_staged
rem   4. scores everything against v1 (run-id b0_noids_staged)
rem Output is appended to api\run_metrics\model_eval\run_b0_noids_staged.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_b0_noids_staged.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 61 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_learning_v2 tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo === v2_b0_noids_staged === >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_b0_noids_staged >> "%LOG%" 2>&1
echo Built %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3 v2_b0_noids >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3 v2_b0_noids_staged >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v2_b0_seed1 v2_b0_noids v2_b0_noids_staged lgbm_v3 --seasons 25 --no-panel --set lgbm_v3_mix50_v2_b0_seed1=eval-lgbm_v3_mix50_v2_b0_seed1 --set lgbm_v3_mix50_v2_b0_noids=eval-lgbm_v3_mix50_v2_b0_noids --set lgbm_v3_mix50_v2_b0_noids_staged=eval-lgbm_v3_mix50_v2_b0_noids_staged --run-id b0_noids_staged >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
