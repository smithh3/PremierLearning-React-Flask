@echo off
rem Staged model on 2025/26, queued behind the recency comparison: waits for the
rem process id given as the first argument (if any) to exit, runs the unit tests,
rem then builds v2_log_minbands_teams_staged (minutes bands, team-level goal bands,
rem points built from both, in one network). Its plan file
rem (learning_v2/model_plans/simple_h1_teams_staged.json) is read when the build
rem starts, so pooling / fading-average choices can be set there until then.
rem After the build: blend 25% with v2_log_h5 and score against v1, the live
rem blend and v2_log_minbands_teams (blended and not).
rem Output is appended to api\run_metrics\model_eval\run_staged_comparison.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_staged_comparison.log
set SCORE=evaluate --seasons 25 --no-panel --set v2_log_minbands_blend25=eval-v2_log_minbands_blend25 --set v2_log_minbands_teams_blend25=eval-v2_log_minbands_teams_blend25
set KNOWN=v1 v1_h5 v2_log_minbands v2_log_minbands_teams
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_learning_v2 tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_log_minbands_teams_staged >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_log_minbands_teams_staged >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval %SCORE% --experiments %KNOWN% v2_log_minbands_teams_staged --set v2_log_minbands_teams_staged_blend25=eval-v2_log_minbands_teams_staged_blend25 --run-id staged_1 >> "%LOG%" 2>&1
echo Done 1/1 v2_log_minbands_teams_staged %DATE% %TIME% >> "%LOG%"
echo Finished %DATE% %TIME% >> "%LOG%"
