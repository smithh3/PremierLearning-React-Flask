@echo off
rem Identity look-ahead test (2026-11-05). Optionally waits for the process id
rem given as the first argument to exit, then:
rem   1. runs the unit tests (stops if any fail)
rem   2. builds v2_b0_nopid (no player id embeddings) and v2_b0_noids (no id
rem      embeddings at all) on 2025/26, ~3.5 h each
rem   3. scores them against v1, B0 seeds 1 and 2 (the noise floor) and
rem      lgbm_v3 (run-id id_lookahead)
rem Output is appended to api\run_metrics\model_eval\run_id_lookahead.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_id_lookahead.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_lgbm tests.test_model_eval tests.test_learning_v2 >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_b0_nopid v2_b0_noids >> "%LOG%" 2>&1
echo Built %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v2_b0_seed1 v2_b0_seed2 v2_b0_nopid v2_b0_noids lgbm_v3 --seasons 25 --no-panel --run-id id_lookahead >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
