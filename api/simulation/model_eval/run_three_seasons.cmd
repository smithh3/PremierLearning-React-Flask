@echo off
rem Best net and best LightGBM over 2023/24-2025/26, then two v3 fantasy manager
rem runs on them (2026-11-07, Hal asked and gave the go-ahead for these two runs).
rem Queued behind the every-5 job (process id given as the first argument). Then:
rem   1. unit tests (stops if any fail)
rem   2. lgbm_v6 for seasons 23, 24 (25 is already built, so it is kept)
rem   3. v2_b1_noids (B1's extra all-competition inputs, no id embeddings) on 25
rem   4. scores it against v2_b0_noids on 25 (run-id net_pick); pick_net keeps
rem      v2_b1_noids unless it is more than 0.10 below (Hal: prefer more data)
rem   5. the chosen net for 23, 24, 25 (25 kept when its code is unchanged)
rem   6. scores both over three seasons (run-id three_seasons). v1 has no 23/24
rem      set, so the baseline is v1_h5 (set 29, same model at horizon 5); the old
rem      manager inputs v2_log (21) and v2_log_minbands_blend25 (35) are included
rem   7. checks each set has 38 complete snapshots per season, then starts two
rem      v3 manager runs (fpl_manager\run_manager_v3.cmd, run until stopped):
rem      fpl_manager_runs\v3_<net> and fpl_manager_runs\v3_lgbm_v6
rem Output is appended to api\run_metrics\model_eval\run_three_seasons.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_three_seasons.log
set PICK=run_metrics\model_eval\three_seasons_pick.txt
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_lgbm_news tests.test_lgbm tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo === lgbm_v6 seasons 23-25 %DATE% %TIME% === >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 23,24,25 --only lgbm_v6 >> "%LOG%" 2>&1
echo === v2_b1_noids season 25 %DATE% %TIME% === >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_b1_noids >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v2_b0_noids v2_b1_noids lgbm_v6 --seasons 25 --no-panel --run-id net_pick >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.pick_net pick net_pick > "%PICK%" 2>> "%LOG%"
set NET=
set /p NET=<"%PICK%"
if "%NET%"=="" (
    echo No net picked, stopping %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Picked %NET% %DATE% %TIME% >> "%LOG%"
echo === %NET% seasons 23-25 %DATE% %TIME% === >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 23,24,25 --only %NET% >> "%LOG%" 2>&1
echo Built %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval evaluate --experiments %NET% lgbm_v6 --set v1=29 --set v2_log=21 --set v2_log_minbands_blend25=35 --seasons 23,24,25 --no-panel --run-id three_seasons >> "%LOG%" 2>&1

"%PYTHON%" -m simulation.model_eval.pick_net set-id %NET% > "%PICK%.net" 2>> "%LOG%"
if errorlevel 1 (
    echo %NET% set incomplete, no manager runs started %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
"%PYTHON%" -m simulation.model_eval.pick_net set-id lgbm_v6 > "%PICK%.lgbm" 2>> "%LOG%"
if errorlevel 1 (
    echo lgbm_v6 set incomplete, no manager runs started %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
set /p NET_SET=<"%PICK%.net"
set /p LGBM_SET=<"%PICK%.lgbm"
echo Starting manager runs %DATE% %TIME%: %NET% set %NET_SET%, lgbm_v6 set %LGBM_SET% >> "%LOG%"
start "" /b cmd /c fpl_manager\run_manager_v3.cmd %NET_SET% fpl_manager_runs\v3_%NET%
start "" /b cmd /c fpl_manager\run_manager_v3.cmd %LGBM_SET% fpl_manager_runs\v3_lgbm_v6
echo Finished %DATE% %TIME% >> "%LOG%"
