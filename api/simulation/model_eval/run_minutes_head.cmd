@echo off
rem Build the two v2_log minutes-head variants, then the cheating oracle, on
rem 2025/26, with no terminal attached. Scores after each, so stopping early still
rem leaves results. Everything lands in model_eval.db under eval-* names, so the
rem manager sets do not change.
rem Output is appended to api\run_metrics\model_eval\run_minutes_head.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_minutes_head.log
echo. >> "%LOG%"
echo Started %DATE% %TIME% >> "%LOG%"

for %%M in (v2_log_minbands v2_log_minlog v2_log_oracle_minutes) do (
    "%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only %%M >> "%LOG%" 2>&1
    "%PYTHON%" -m simulation.model_eval evaluate --seasons 25 --no-panel --run-id after_%%M >> "%LOG%" 2>&1
    echo Done %%M %DATE% %TIME% >> "%LOG%"
)
echo Finished %DATE% %TIME% >> "%LOG%"
