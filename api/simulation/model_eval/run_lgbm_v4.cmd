@echo off
rem LightGBM next steps (2026-11-07, Hal asked for all three), queued behind the
rem every-5 resume job (process id given as the first argument). Then:
rem   1. runs the unit tests (stops if any fail)
rem   2. builds lgbm_v3_tweedie (v3, Tweedie objective), lgbm_v4 (feature set 3:
rem      team ratings, opponent conceded by position, shrunk per-90s, competition
rem      for his place) and lgbm_v5 (v4 inputs in stages: minutes, clean sheet,
rem      rest of points), ~1-1.5 h each, one python process each
rem   3. 50/50 mixes of v4 and v5 with the no-id B0 net
rem   4. scores everything against v1 (run-id lgbm_v4)
rem Output is appended to api\run_metrics\model_eval\run_lgbm_v4.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_lgbm_v4.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_lgbm tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo === lgbm_v3_tweedie %DATE% %TIME% === >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only lgbm_v3_tweedie >> "%LOG%" 2>&1
echo === lgbm_v4 %DATE% %TIME% === >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only lgbm_v4 >> "%LOG%" 2>&1
echo === lgbm_v5 %DATE% %TIME% === >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only lgbm_v5 >> "%LOG%" 2>&1
echo Built %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v4 v2_b0_noids >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v5 v2_b0_noids >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v2_b0_noids lgbm_v3 lgbm_v3_tweedie lgbm_v4 lgbm_v5 --seasons 25 --no-panel --set lgbm_v3_mix50_v2_b0_noids=eval-lgbm_v3_mix50_v2_b0_noids --set lgbm_v4_mix50_v2_b0_noids=eval-lgbm_v4_mix50_v2_b0_noids --set lgbm_v5_mix50_v2_b0_noids=eval-lgbm_v5_mix50_v2_b0_noids --run-id lgbm_v4 >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
