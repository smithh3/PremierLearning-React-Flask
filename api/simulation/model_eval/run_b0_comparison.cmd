@echo off
rem B0: the base for the external-data wave, retrained after the 2021/22 data swap.
rem Waits for the process id given as the first argument (the external-data chat's
rem overnight job, which swaps 2021/22 to the full vaastav CSV) to exit, then:
rem   1. pick_base scores every wave A candidate together (run-id wave_a_final) and
rem      copies the winner's plan to learning_v2/model_plans/simple_h1_b0.json
rem   2. runs the unit tests (stops if any fail)
rem   3. builds v2_b0_seed1 and v2_b0_seed2 (seeds 42 and 43), blends each 25%
rem      with v2_log_h5, and scores them (run-id b0). The seed gap is the noise floor.
rem Output is appended to api\run_metrics\model_eval\run_b0_comparison.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_b0_comparison.log
set CANDIDATES=v2_log_minbands_teams v2_log_minbands_teams_score v2_log_minbands_teams_scoreline v2_log_minbands_teams_recency_nodecay v2_log_minbands_teams_recency v2_log_minbands_teams_staged
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Picking the base %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval.pick_base --run-id wave_a_final --candidates %CANDIDATES% >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Could not pick a base, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_learning_v2 tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_b0_seed1 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_b0_seed1 >> "%LOG%" 2>&1
echo Done 1/2 v2_b0_seed1 %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_b0_seed2 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend v2_b0_seed2 >> "%LOG%" 2>&1
echo Done 2/2 v2_b0_seed2 %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval evaluate --seasons 25 --no-panel --experiments v1 v1_h5 v2_log_minbands v2_log_minbands_teams v2_b0_seed1 v2_b0_seed2 --set v2_log_minbands_blend25=eval-v2_log_minbands_blend25 --set v2_log_minbands_teams_blend25=eval-v2_log_minbands_teams_blend25 --set v2_b0_seed1_blend25=eval-v2_b0_seed1_blend25 --set v2_b0_seed2_blend25=eval-v2_b0_seed2_blend25 --run-id b0 >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
