@echo off
rem Build the fantasy-manager prediction sets for 2023/24 to 2025/26, with no
rem terminal attached. Everything lands in model_eval.db under eval-* names, so
rem fantasy.db and the default set of any existing manager run do not change.
rem Output is appended to api\run_metrics\model_eval\run_manager_sets.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_manager_sets.log
echo. >> "%LOG%"
echo Started %DATE% %TIME% >> "%LOG%"

rem v1's code hash moved since its 2025/26 set, so all three seasons are rebuilt.
"%PYTHON%" -m simulation.model_eval build-all --seasons 23,24,25 --only v1_h5 >> "%LOG%" 2>&1

rem Set 21 keeps its 2025/26 rows: the current code repeats that fit epoch for epoch.
"%PYTHON%" -m simulation.prediction_builder --learning-v2 --train-once-per-season --points-reps 1 --v2-weighting none --v2-loss huber --v2-smear global --seasons 25 --name eval-v2_log --prediction-set-id 21 --adopt-code-hash --coverage-only >> "%LOG%" 2>&1

"%PYTHON%" -m simulation.model_eval build-all --seasons 23,24 --only v2_log v2_log_h5 >> "%LOG%" 2>&1

rem Fails if any season is missing, so a partial chain is never reported as ready.
"%PYTHON%" -m simulation.model_eval.manager_sets >> "%LOG%" 2>&1
echo Exit %ERRORLEVEL% >> "%LOG%"
echo Finished %DATE% %TIME% >> "%LOG%"
