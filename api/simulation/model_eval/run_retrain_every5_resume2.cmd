@echo off
rem Second resume of the every-5 B1 retrain (2026-11-07). Hal asked for the
rem LightGBM v3 tweedie/v4/v5 builds to go first, so run_retrain_every5_resume.cmd
rem was stopped during the GW26 refit (GW1-25 are kept in the prediction set) and
rem this waits for the LightGBM job (process id given as the first argument).
rem As before, PL_RETRAIN_MAX_FITS=1 gives each refit a fresh process: calls for
rem GW26, 31 and 36, and a fourth that only checks nothing is left. Then the mixes
rem and the final evaluation, unchanged from run_retrain_every5_resume.cmd.
rem Output is appended to api\run_metrics\model_eval\run_retrain_every5.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_retrain_every5.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
set PL_RETRAIN_MAX_FITS=1
echo Resumed %DATE% %TIME%: one refit per process >> "%LOG%"
for %%N in (1 2 3 4) do (
    echo Build call %%N %DATE% %TIME% >> "%LOG%"
    "%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only v2_b1_every5 >> "%LOG%" 2>&1
)
echo Built v2_b1_every5 %DATE% %TIME% >> "%LOG%"
set PL_RETRAIN_MAX_FITS=
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3_every5 v2_b1_every5 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v3 v2_b1_context >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v2_b0_seed1 v2_b0_noids v2_b1_context v2_b1_every5 lgbm_v3 lgbm_v3_every5 --seasons 25 --no-panel --set lgbm_v3_mix50_v2_b0_seed1=eval-lgbm_v3_mix50_v2_b0_seed1 --set lgbm_v3_mix50_v2_b1_context=eval-lgbm_v3_mix50_v2_b1_context --set lgbm_v3_every5_mix50_v2_b1_every5=eval-lgbm_v3_every5_mix50_v2_b1_every5 --run-id retrain_every5 >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
