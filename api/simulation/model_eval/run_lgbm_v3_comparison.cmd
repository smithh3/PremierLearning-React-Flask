@echo off
rem LightGBM v3: feature set 2 (many windows on every history, trends, venue
rem form, fixture matchups, xG shares), 3 seeds averaged. Optionally waits for
rem the process id given as the first argument to exit, then:
rem   1. runs the unit tests (stops if any fail)
rem   2. builds lgbm_v3 (no team ids), lgbm_v3_ids (ids kept) and
rem      lgbm_v3_simple (v1 inputs) on 2025/26
rem   3. blends lgbm_v3 25% with v2_log_h5, and 50/50 mixes of lgbm_v1 and
rem      lgbm_v3 with the B0 net (v2_b0_seed1)
rem   4. scores everything against v1, the nets and lgbm_v1 / v2 (run-id lgbm_v3)
rem Output is appended to api\run_metrics\model_eval\run_lgbm_v3_comparison.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set PYTHON=..\venv\Scripts\python.exe
set LOG=run_metrics\model_eval\run_lgbm_v3_comparison.log
echo. >> "%LOG%"
echo Queued %DATE% %TIME%, waiting for process %1 >> "%LOG%"
if "%1"=="" goto start
:wait
tasklist /FI "PID eq %1" 2>nul | find "%1" >nul
if errorlevel 1 goto start
ping -n 301 127.0.0.1 >nul
goto wait

:start
echo Testing %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m unittest tests.test_lgbm tests.test_model_eval >> "%LOG%" 2>&1
if errorlevel 1 (
    echo Tests failed, nothing built %DATE% %TIME% >> "%LOG%"
    exit /b 1
)
echo Started %DATE% %TIME%, 2025/26 only >> "%LOG%"
"%PYTHON%" -m simulation.model_eval build-all --seasons 25 --only lgbm_v3 lgbm_v3_ids lgbm_v3_simple >> "%LOG%" 2>&1
echo Built %DATE% %TIME% >> "%LOG%"
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --blend lgbm_v3 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval.manager_sets --seasons 25 --mix lgbm_v1 v2_b0_seed1 --mix lgbm_v3 v2_b0_seed1 >> "%LOG%" 2>&1
"%PYTHON%" -m simulation.model_eval evaluate --experiments v1 v1_h5 v2_b0_seed1 v2_b0_seed2 v2_b1_context lgbm_v1 lgbm_v2 lgbm_v3 lgbm_v3_ids lgbm_v3_simple --seasons 25 --no-panel --set v2_b0_seed1_blend25=eval-v2_b0_seed1_blend25 --set v2_b0_seed2_blend25=eval-v2_b0_seed2_blend25 --set lgbm_v3_blend25=eval-lgbm_v3_blend25 --set lgbm_v1_mix50_v2_b0_seed1=eval-lgbm_v1_mix50_v2_b0_seed1 --set lgbm_v3_mix50_v2_b0_seed1=eval-lgbm_v3_mix50_v2_b0_seed1 --run-id lgbm_v3 >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
