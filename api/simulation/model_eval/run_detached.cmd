@echo off
rem Build experiments, then evaluate, with no terminal attached.
rem   run_detached.cmd 25                          every experiment
rem   run_detached.cmd "23,24,25"                  quoted: cmd splits arguments on commas
rem   run_detached.cmd 25 v2_huber v2_tier         only these (v1 is reused from its saved set)
rem Same database as the "model eval" launch configs. Output is appended to
rem api\run_metrics\model_eval\run_<seasons>.log
rem Do not edit this file while it runs: cmd reads it as it goes.
cd /d "%~dp0..\.."
set DATABASE_PATH=/data/model_eval.db
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1
set SEASONS=%~1
if "%SEASONS%"=="" set SEASONS=25
set ONLY=
:collect
shift
if "%~1"=="" goto run
set ONLY=%ONLY% %~1
goto collect
:run
set PYTHON=..\venv\Scripts\python.exe
if not exist run_metrics\model_eval mkdir run_metrics\model_eval
set LOG=run_metrics\model_eval\run_%SEASONS:,=_%.log
echo. >> "%LOG%"
echo Started %DATE% %TIME%, seasons %SEASONS%, experiments:%ONLY% >> "%LOG%"
if defined ONLY (
    "%PYTHON%" -m simulation.model_eval build-all --seasons %SEASONS% --only%ONLY% >> "%LOG%" 2>&1
) else (
    "%PYTHON%" -m simulation.model_eval build-all --seasons %SEASONS% >> "%LOG%" 2>&1
)
rem Evaluate even if one build failed: it scores whatever is complete.
"%PYTHON%" -m simulation.model_eval evaluate --seasons %SEASONS% >> "%LOG%" 2>&1
echo Finished %DATE% %TIME% >> "%LOG%"
