@echo off
rem Full external-data refresh: ESPN all competitions + Wikipedia managers -> api\data\external\*.csv
rem Safe to re-run: only new / recent days and new matches are downloaded.
rem Do not edit this file while it is running (cmd reads it line by line).
cd /d "%~dp0..\.."
set PYTHONIOENCODING=utf-8
echo ==== start %date% %time% >> data\external\crawl.log
"..\venv\Scripts\python.exe" -u -m premierlearning.external_data all >> data\external\crawl.log 2>&1
echo ==== crawl exit %errorlevel% %date% %time% >> data\external\crawl.log
"..\venv\Scripts\python.exe" -u -m premierlearning.external_data.qa >> data\external\crawl.log 2>&1
echo ==== qa exit %errorlevel% %date% %time% >> data\external\crawl.log
