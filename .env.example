# Copy to .env and fill in. Never commit .env.

FPL_EMAIL=
FPL_PASSWORD=
FPL_REFRESH_TOKEN=
FPL_ID=

# 0 = apply/suggest against an existing database/fantasy.db
# 1 = run premierlearning first, then squadtools
RUN_LEARNING=0
PREMIERLEARNING_ARGS=--horizon-reps 5

# Safety: suggest first. Set APPLY_TRANSFERS=true only when you intend to submit.
SUGGEST_TRANSFERS=true
APPLY_TRANSFERS=false
APPLY_TEAM_SELECTION=false

# After GW1, refuse apply if the deadline is further away than this (hours). Leave empty to disable.
APPLY_WITHIN_HOURS=

# Daily Fargate: apply transfers only when today is the next GW deadline (UK).
APPLY_ON_DEADLINE_DAY=true

FPL_LOGIN_HEADLESS=1
DATABASE_PATH=/data/fantasy.db

# HTML predictions email (Fargate uses SES). Local runs send only if AWS creds + verified identity exist.
# Plus-alias destination: create a Gmail filter for to:haljsmith97+fpl@gmail.com → Never send to Spam.
NOTIFY_EMAIL=haljsmith97+fpl@gmail.com
SES_FROM_EMAIL=haljsmith97@gmail.com
